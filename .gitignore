# Rust build artifacts
target/

# Demo binary output — regenerated by `cargo run`, not source
neos/render.ppm
neos/render.gif
neos/render_audio.ppm
neos/render_audio.gif
neos/render_video.ppm
neos/render_video.gif
neos/report.json

# Local, machine-specific Claude Code settings
.claude/settings.local.json

# Generated tool cache/index (graphify) — not NEOS source, law, or spec
graphify-out/

# C build artifacts from neos/media_ffi/ffi_test/build_and_run.bat —
# regenerated by that script, not source. media_ffi.h is the checked-in
# source of truth for the header; this is just the copied .dll it links.
neos/media_ffi/ffi_test/*.exe
neos/media_ffi/ffi_test/*.obj
neos/media_ffi/ffi_test/*.pdb
neos/media_ffi/ffi_test/*.dll
neos/media_ffi/ffi_test/*.lib
neos/media_ffi/ffi_test/*.exp
